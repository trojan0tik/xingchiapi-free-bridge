[Unit]
Description=xingchiapi-free-bridge — header injector for client-gated LLM upstreams
Documentation=https://github.com/<your-user>/xingchiapi-free-bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/xingchiapi-free-bridge
Environment=PORT=8792
Environment=BIND_HOST=127.0.0.1
Environment=UPSTREAM=https://api.xingchiapi.com
Environment=UA="claude-cli/2.1.92 (external, sdk-cli)"
Environment=XAPP="cli"
Environment=LOG_REQUESTS=1
Environment=NODE_ENV=production
ExecStart=/usr/bin/node /home/ubuntu/xingchiapi-free-bridge/proxy.js
Restart=always
RestartSec=3
StandardOutput=append:/home/ubuntu/xingchiapi-free-bridge/bridge.log
StandardError=append:/home/ubuntu/xingchiapi-free-bridge/bridge.log

# hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/ubuntu/xingchiapi-free-bridge
ProtectKernelTunables=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
